# ytdl4.me configuration — every value has a safe default; copy to .env to override.

# HTTP port the server listens on.
PORT=8382

# Optional shared password gate. Leave UNSET for an open instance on a trusted LAN.
# Set it (use a long, random value) to safely expose the instance to the internet.
# YTDL_PASSWORD=

# Stable secret used to sign session cookies. If unset, it is derived from the
# password. Set an explicit random value if you want sessions to survive a
# password change.
# YTDL_SESSION_SECRET=

# Only honor X-Forwarded-For / X-Forwarded-Proto when behind a reverse proxy you
# control. Leave false otherwise (prevents header spoofing of rate limits).
TRUST_PROXY=false

# Maximum number of downloads processed at once. Keep low on small hosts.
CONCURRENCY=1

# Retention window. Files live between TTL_MIN and TTL_MAX minutes, scaled by size.
TTL_MIN_MINUTES=30
TTL_MAX_MINUTES=60
TTL_MINUTES_PER_GB=20

# Reject any single download larger than this (MB).
MAX_FILE_SIZE_MB=2048

# Reject/queue new jobs once the temp directory exceeds this total (MB).
TEMP_BUDGET_MB=8192

# Stop a single job after this many seconds (protects against stuck downloads).
JOB_TIMEOUT_SECONDS=1800

# How long a metadata probe may run before giving up (seconds).
PROBE_TIMEOUT_SECONDS=60

# Where temporary files are written. In Docker this is a tmpfs volume.
# TEMP_DIR=/data/temp

# Path to the yt-dlp binary (the Docker image ships one on PATH).
# YTDLP_PATH=yt-dlp

# Optional path to a YouTube cookies.txt (the bot-wall escape hatch).
# This file is a LIVE credential — use a throwaway account and mount it read-only.
# COOKIES_FILE=/data/cookies.txt
